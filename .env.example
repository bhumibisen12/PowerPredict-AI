# ==============================================================================
# PowerPredict AI - Environment Configuration Template
# Copy this file to '.env' and fill in your secrets.
# NEVER commit your actual '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Application & Site URLs
# ------------------------------------------------------------------------------
SITE_URL=http://localhost:8000
ADMIN_EMAIL=admin@powerpredict.ai

# ------------------------------------------------------------------------------
# 2. Production SMTP Email Dispatcher (Resend / SendGrid / Amazon SES / Postmark)
# If empty, the app runs in dev simulation mode and safely logs emails to console/audit.
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=re_your_api_key_here
SMTP_FROM=PowerPredict AI <no-reply@yourdomain.com>

# ------------------------------------------------------------------------------
# 3. Optional: Supabase Auth & PostgreSQL Integration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
